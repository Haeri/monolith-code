{
  "name": "monolith-code",
  "version": "2.4.0",
  "description": "minimalistic code editor",
  "homepage": "https://haeri.github.io/monolith-code/",
  "main": "main.js",
  "desktopName": "monolith-code.desktop",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "start": "electron .",
    "lint": "eslint main.js src/*.js eslint.config.js",
    "security:audit": "pnpm audit --audit-level moderate",
    "package": "electron-builder",
    "test-build": "electron-builder --publish never"
  },
  "keywords": [
    "code",
    "editor"
  ],
  "author": "Haeri",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.17.0",
    "electron-builder-squirrel-windows": "26.17.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13"
  },
  "build": {
    "appId": "monolith-code",
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!build/**",
      "!.github/**",
      "!scripts/**",
      "!res/img/icon.pdn",
      "!eslint.config.js",
      "!pnpm-workspace.yaml",
      "!README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development;TextEditor;Utility",
      "maintainer": "Haeri <7956606+Haeri@users.noreply.github.com>",
      "synopsis": "Minimalistic code editor",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "monolith code",
          "Keywords": "code;editor;text;markdown;latex;"
        }
      },
      "mimeTypes": [
        "text/plain",
        "text/markdown",
        "text/x-csrc",
        "text/x-chdr",
        "text/x-c++src",
        "text/x-c++hdr",
        "text/x-csharp",
        "text/x-java",
        "text/x-python",
        "text/x-python3",
        "text/x-go",
        "text/x-tex",
        "text/x-bibtex",
        "text/html",
        "text/css",
        "text/javascript",
        "application/javascript",
        "application/json",
        "application/xml",
        "text/xml",
        "application/yaml",
        "application/x-yaml",
        "application/x-shellscript",
        "application/x-php",
        "application/sql"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "fileAssociations": [
      {
        "ext": "bash",
        "name": "Bash",
        "role": "Editor"
      },
      {
        "ext": "bat",
        "name": "Batch",
        "role": "Editor"
      },
      {
        "ext": "cmd",
        "name": "Batch",
        "role": "Editor"
      },
      {
        "ext": "c",
        "name": "C",
        "role": "Editor"
      },
      {
        "ext": "h",
        "name": "C",
        "role": "Editor"
      },
      {
        "ext": "cpp",
        "name": "C++",
        "role": "Editor"
      },
      {
        "ext": "hpp",
        "name": "C++",
        "role": "Editor"
      },
      {
        "ext": "cs",
        "name": "C#",
        "role": "Editor"
      },
      {
        "ext": "css",
        "name": "CSS",
        "role": "Editor"
      },
      {
        "ext": "dart",
        "name": "DART",
        "role": "Editor"
      },
      {
        "ext": "go",
        "name": "Go",
        "role": "Editor"
      },
      {
        "ext": "html",
        "name": "HTML",
        "role": "Editor"
      },
      {
        "ext": "java",
        "name": "Java",
        "role": "Editor"
      },
      {
        "ext": "js",
        "name": "JavaScript",
        "role": "Editor"
      },
      {
        "ext": "json",
        "name": "JSON",
        "role": "Editor"
      },
      {
        "ext": "tex",
        "name": "LaTeX",
        "role": "Editor"
      },
      {
        "ext": "latex",
        "name": "LaTeX",
        "role": "Editor"
      },
      {
        "ext": "bib",
        "name": "LaTeX",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "php",
        "name": "PHP",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Plain Text",
        "role": "Editor"
      },
      {
        "ext": "ps1",
        "name": "PowerShell",
        "role": "Editor"
      },
      {
        "ext": "sh",
        "name": "Bash",
        "role": "Editor"
      },
      {
        "ext": "py",
        "name": "Python",
        "role": "Editor"
      },
      {
        "ext": "sql",
        "name": "SQL",
        "role": "Editor"
      },
      {
        "ext": "swift",
        "name": "Swift",
        "role": "Editor"
      },
      {
        "ext": "ts",
        "name": "TypeScript",
        "role": "Editor"
      },
      {
        "ext": "xml",
        "name": "XML",
        "role": "Editor"
      },
      {
        "ext": "yaml",
        "name": "YAML",
        "role": "Editor"
      },
      {
        "ext": "yml",
        "name": "YAML",
        "role": "Editor"
      }
    ]
  }
}
